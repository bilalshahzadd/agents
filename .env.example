NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://spheric:spheric@localhost:5432/spheric
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AUTO_RESEARCH_ENABLED=false
RESEARCH_INTERVAL_MS=21600000

# Seed admin (development only)
SEED_ADMIN_EMAIL=admin@spheric.local
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!

# Platform credentials are connected per SocialAccount through encrypted records.
# These app-level IDs/secrets enable OAuth handshakes where applicable.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Web
NEXT_PUBLIC_API_PROXY=/api/backend
API_INTERNAL_URL=http://localhost:4000
COOKIE_SECURE=false

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EAS_PROJECT_ID=
SENTRY_DSN=

# Runtime tuning
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000
AGENT_WORKER_CONCURRENCY=3
PUBLISH_WORKER_CONCURRENCY=5
ANALYTICS_WORKER_CONCURRENCY=5
PUBLISH_RATE_MAX=30
PUBLISH_RATE_WINDOW_MS=60000
LOG_LEVEL=info
